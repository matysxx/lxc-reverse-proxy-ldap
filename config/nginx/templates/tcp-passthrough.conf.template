# Generic TCP/TLS passthrough template for nginx stream.
# Replace placeholders in host-local configuration only.

server {
  listen __LISTEN_ADDRESS__:__LISTEN_PORT__;

  # Restrict to local/private networks unless the service is explicitly public.
  allow 10.0.0.0/8;
  allow 172.16.0.0/12;
  allow 192.168.0.0/16;
  deny all;

  proxy_pass __BACKEND_ADDRESS__:__BACKEND_PORT__;
  proxy_connect_timeout 10s;
  proxy_timeout 1h;
  proxy_socket_keepalive on;
}
