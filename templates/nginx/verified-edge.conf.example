# Render locally. Install as an http-context include, without HTTP/2.
map $http_upgrade $verified_edge_connection {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name {{SERVICE_HOSTNAME}};
    return 301 https://{{SERVICE_HOSTNAME}}$request_uri;
}

server {
    listen 443 ssl;
    server_name {{SERVICE_HOSTNAME}};
    ssl_certificate {{FRONTEND_CERTIFICATE}};
    ssl_certificate_key {{FRONTEND_KEY}};
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/services/{{SERVICE_LOG_NAME}}.access.log;
    error_log /var/log/nginx/services/{{SERVICE_LOG_NAME}}.error.log warn;

    {{INTERNAL_ACCESS_RULES}}
    deny all;

    client_max_body_size 64m;
    location ~* ^/(api/docs|edge-health) { return 404; }

    # Initially include maintenance.conf; switch only after readiness checks.
    include {{ROUTING_FILE}};
}
