location / {
    # No URI suffix: preserve the entire path and query, including /api/.
    proxy_pass {{SERVICE_BACKEND_URL}};
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name {{BACKEND_TLS_NAME}};
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate {{BACKEND_CA_FILE}};
    proxy_ssl_verify_depth 3;

    proxy_set_header Host {{SERVICE_HOSTNAME}};
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host {{SERVICE_HOSTNAME}};
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Server "";
    proxy_set_header X-Forwarded-Prefix "";
    proxy_set_header X-Original-URL "";
    proxy_set_header X-Rewrite-URL "";
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $verified_edge_connection;

    proxy_connect_timeout 10s;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
    proxy_redirect off;
}
